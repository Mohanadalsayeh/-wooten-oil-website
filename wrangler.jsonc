{
  "name": "wooten-oil",
  "main": "worker.js",
  "compatibility_date": "2026-08-16",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "vars": {
    "FUEL_TO_EMAIL": "support@wootenoil.com",
    "FUEL_FROM_EMAIL": "fuel@wootenoil.com",
    "GP_ENVIRONMENT": "sandbox",
    "GP_MAX_PAYMENT_CENTS": "50000000"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wooten-oil-requests",
      "database_id": "6a293919-08d6-4cd7-b40e-1fe6b44b6590"
    }
  ],

  "r2_buckets": [
    {
      "binding": "NOTIFICATION_ATTACHMENTS",
      "bucket_name": "wooten-notification-attachments"
    }
  ]
}
